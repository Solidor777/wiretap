{
   "compilerOptions": {
      "module": "esnext",
      "moduleResolution": "bundler",
      "target": "es2022",
      "strict": true,
      "allowJs": true,
      "checkJs": false,
      "allowImportingTsExtensions": true,
      "noEmit": true,
      "skipLibCheck": true,
      "types": ["node"]
   },
   "include": [
      "**/*.ts",
      "../shared/**/*.js"
   ]
}
