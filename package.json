{
   "name": "wiretap",
   "version": "0.0.1",
   "description": "Adds a tab and bridge for AI agents inside Foundry VTT.",
   "license": "MIT",
   "private": true,
   "type": "module",
   "author": "Solidor",
   "dependencies": {
      "socket.io": "^4.8.3"
   },
   "devDependencies": {
      "@playwright/test": "^1.60.0",
      "@sveltejs/vite-plugin-svelte": "^7.1.2",
      "@testing-library/jest-dom": "^6.9.1",
      "@testing-library/svelte": "^5.3.1",
      "@types/node": "^22.10.02",
      "autoprefixer": "^10.4.19",
      "esbuild": "^0.28.0",
      "eslint": "^9.3.0",
      "eslint-plugin-jsdoc": "^48.2.5",
      "eslint-plugin-svelte": "^2.39.0",
      "happy-dom": "^20.9.0",
      "sass-embedded": "^1.100.0",
      "socket.io-client": "^4.8.3",
      "stylelint": "^16.12.0",
      "stylelint-config-html": "^1.1.0",
      "stylelint-config-standard-scss": "^16.0.0",
      "svelte": "^5.0.0",
      "svelte-preprocess": "^6.0.2",
      "terser": "^5.48.0",
      "tsx": "^4.19.0",
      "typescript": "^5.7.0",
      "vite": "^8.0.14",
      "vitest": "^4.1.7"
   },
   "browserslist": [
      "defaults"
   ],
   "scripts": {
      "build": "vite build",
      "build:e2e": "vite build --mode e2e",
      "dev": "vite",
      "test": "vitest run",
      "test:watch": "vitest",
      "test:e2e": "playwright test",
      "test:e2e:headed": "playwright test --headed",
      "test:e2e:ui": "playwright test --ui",
      "eslint": "eslint .",
      "eslint-fix": "eslint . --fix",
      "server": "tsx watch server/index.ts",
      "server:start": "tsx server/index.ts",
      "typecheck": "tsc -p server/tsconfig.json",
      "stylelint": "stylelint \"src/**/*.{css,svelte}\"",
      "stylelint-fix": "stylelint \"src/**/*.{css,svelte}\" --fix"
   }
}
